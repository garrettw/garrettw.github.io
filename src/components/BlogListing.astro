---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
    posts: CollectionEntry<'blog'>[];
    allPosts: CollectionEntry<'blog'>[];
    category?: string;
}

const { posts, allPosts, category } = Astro.props;

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
    for (const postCategory of new Set(post.data.categories ?? [])) {
        categoryCounts.set(postCategory, (categoryCounts.get(postCategory) ?? 0) + 1);
    }
}
const categories = [...categoryCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title={category ? `${category} | Blog` : 'Blog Index'}>
    <main class="wrapper blog-layout">
        <section aria-label="Blog posts">
            {category && (
                <>
                    <a class="all-posts" href="/blog/">&lt; All posts</a> | {category}
                </>
            )}
            <ul class="posts">
                {
                    posts.map((post) => (
                        <li>
                            <a href={`/blog/${post.id}/`}>
                                <h4 class="title">{post.data.title}</h4>
                                <p class="date">
                                    <FormattedDate date={post.data.pubDate || new Date()} />
                                </p>
                                <p class="description">
                                    {post.data.description || 'No snippet available.'}
                                </p>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>
        <aside aria-labelledby="categories-heading">
            <h2 id="categories-heading">Categories</h2>
            <ul class="categories">
                {
                    categories.map(([categoryName, count]) => (
                        <li class={categoryName === category ? 'active' : undefined}>
                            <a
                                href={`/blog/category/${encodeURIComponent(categoryName)}/`}
                                aria-current={categoryName === category ? 'page' : undefined}
                            >
                                {categoryName}
                            </a>
                            <span class="category-count">{count}</span>
                        </li>
                    ))
                }
            </ul>
        </aside>
    </main>
    <style>
        .blog-layout {
            padding: 0 2rem;
            display: grid;
            gap: 2rem;
            text-align: left;
        }

        .posts,
        .categories {
            list-style: none;
            padding: 0;
        }

        .posts li {
            margin-bottom: 1rem;
        }

        .posts a {
            text-decoration: none;
        }

        .all-posts {
            display: inline-block;
            margin-bottom: 1rem;
        }

        .title {
            text-decoration: underline;
        }

        .date {
            color: var(--gray-400);
        }

        .description {
            color: var(--gray-100);
        }

        aside {
            align-self: start;
            padding: 1.25rem;
            border: 1px solid var(--gray-700);
            border-radius: 0.75rem;
        }

        aside h2 {
            margin-bottom: 1rem;
            font-size: var(--text-xl);
        }

        .categories li {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding-block: 0.5rem;
            border: 1px solid transparent;
            border-radius: 0.5rem;
        }

        .categories li.active {
            margin-block: 0.25rem;
            padding-inline: 0.5rem;
            border-color: var(--gray-700);
        }

        .category-count {
            color: var(--gray-400);
        }

        @media (min-width: 50em) {
            .blog-layout {
                grid-template-columns: minmax(0, 1fr) 16rem;
                gap: 3rem;
            }
        }
    </style>
</BaseLayout>
