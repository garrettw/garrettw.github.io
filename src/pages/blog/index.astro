---
import BlogListing from '../../components/BlogListing.astro';
import { getPublishedBlogPosts } from '../../utils/blog';

const posts = (await getPublishedBlogPosts()).sort((a, b) => {
    const aDate = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const bDate = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return bDate - aDate;
});
---

<BlogListing posts={posts} allPosts={posts} />
